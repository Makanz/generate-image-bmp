PORT=3001

# Optional shared secret protecting mutating endpoints (POST /api/refresh,
# POST /api/refresh-interval). When set, requests must include the header
# "X-Api-Token: <token>". When unset, the endpoints are left open.
# Generate one with: openssl rand -hex 32
API_TOKEN=

# Which dashboard design to serve at "/" (and capture to BMP): classic (default) or summer
DASHBOARD_DESIGN=classic

# How often (minutes) to regenerate the dashboard image
REFRESH_INTERVAL_MINUTES=15

# Quiet hours: skip scheduled generation between these hours (local time, 0–23)
# If unset, generation runs around the clock.
# Example: skip 01:00–05:59 → QUIET_HOURS_START=1 QUIET_HOURS_END=6
# QUIET_HOURS_START=1
# QUIET_HOURS_END=6

# Per-source cache TTL (optional, shown with defaults)
# WEATHER_REFRESH_MINUTES=15
# CALENDAR_REFRESH_MINUTES=15
# LUNCH_REFRESH_HOURS=24
# INDOOR_REFRESH_MINUTES=15

# How long to wait before retrying a failed data source (optional)
# ERROR_RETRY_MINUTES=2

# Weather: coordinates for Open-Meteo (api.open-meteo.com) — free, no API key needed
# Set these to your own location. Leaving them empty disables the weather source.
OPEN_METRO_LAT=
OPEN_METRO_LON=

# n8n webhooks returning JSON. Use the full URL of your own n8n instance.
N8N_WEBHOOK_CALENDAR=
N8N_WEBHOOK_LUNCH=
N8N_WEBHOOK_INDOOR=

# Homey hub (optional alternative to n8n for indoor temperature)
HOMEY_IP=
HOMEY_TOKEN=
HOMEY_USERNAME=
HOMEY_PASSWORD=

# Browserless REST API (optional). If unset, the local Playwright/Chromium is used.
BROWSERLESS_URL=
BROWSERLESS_TOKEN=

# URL the screenshot is captured from. If unset, the local server is used.
CAPTURE_URL=

# Host directory mounted as /app/output, where the generated BMPs are written.
# Absolute path on the Docker host, e.g. /srv/dashboard/output
OUTPUT_VOLUME=./output
